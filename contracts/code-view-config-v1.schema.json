{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-view.local/contracts/code-view-config-v1.schema.json",
  "title": "Code View configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "entry": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["file"],
          "additionalProperties": false,
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "symbol": {"type": "string", "minLength": 1},
            "command": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "object",
                  "required": ["argv", "mode"],
                  "additionalProperties": false,
                  "properties": {
                    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "mode": {"enum": ["document", "manual"]}
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "startCommand": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["argv", "mode"],
          "additionalProperties": false,
          "properties": {
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "mode": {"enum": ["document", "manual"]}
          }
        }
      ]
    },
    "languages": {"const": ["python"]},
    "includeTests": {"type": "boolean"},
    "index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests": {"enum": ["exclude", "include"]},
        "modules": {"enum": ["hide", "show"]},
        "externalPackages": {"const": "collapse"},
        "exclude": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialView": {"enum": ["entry-focus", "whole-repo"]},
        "relationships": {
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["contains", "imports", "calls", "inherits", "constructs", "reads", "writes", "decorates", "type_uses", "api_calls", "test_covers"]}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "contains": {"type": "boolean"},
                "imports": {"type": "boolean"},
                "calls": {"type": "boolean"},
                "inherits": {"type": "boolean"},
                "constructs": {"type": "boolean"},
                "reads": {"type": "boolean"},
                "writes": {"type": "boolean"},
                "decorates": {"type": "boolean"},
                "type_uses": {"type": "boolean"},
                "api_calls": {"type": "boolean"},
                "test_covers": {"type": "boolean"}
              }
            }
          ]
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"base": {"type": "string", "minLength": 1}}
    }
  }
}
